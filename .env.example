# Application environment. Use local on a developer machine and production on the server.
DGR_APP_ENV=local
DGR_APP_URL=http://localhost:8076
DGR_APP_REDIRECT_HOME=http://localhost:8076/index.php
DGR_APP_HTACCESS_PATH=/

# Database connection. Put real credentials in .env, never in this example file.
DGR_DB_HOST=
DGR_DB_NAME=
DGR_DB_USERNAME=
DGR_DB_PASSWORD=

# SMTP credentials used by config/func.class.php.
DGR_SMTP_HOST=
DGR_SMTP_PORT=587
DGR_SMTP_AUTH=true
DGR_SMTP_AUTO_TLS=false
DGR_SMTP_USERNAME=
DGR_SMTP_PASSWORD=

# CKEditor/CKFinder licence values for the current environment.
DGR_CK_LICENSE_NAME=
DGR_CK_LICENSE_KEY=

# Legacy password compatibility. Preserve the existing production values during deployment.
DGR_CONFIG_SALT=
DGR_LEGACY_PASSWORD_PREFIX=

# Generate a unique value of at least 32 random characters for each environment.
# Do not commit the real secret; copy this file to .env or configure the web server environment.
API_JWT_SECRET=

# Optional: writable directory outside the web root for API rate-limit counters.
# Defaults to an application-specific directory under the system temp folder.
API_RATE_LIMIT_DIR=

# Optional comma-separated additional production origins. The primary website
# https://www2.dgr.go.th is always allowed; localhost is allowed only locally.
API_ALLOWED_ORIGINS=

# Localhost only: set to 1 to exercise real OTP email delivery during testing.
API_AUTH_SEND_OTP_EMAIL=0
